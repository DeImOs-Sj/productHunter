# Anthropic API key (classification + email drafting)
NVIDIA_API_KEY=nvapi-...

# Product Hunt developer token — free, get one at https://www.producthunt.com/v2/oauth/applications
# (create an app, then use the "Developer Token")
PH_ACCESS_TOKEN=

# Resend API key for sending — https://resend.com (free tier: 100 emails/day)
# You must verify your sending domain in Resend first.
RESEND_API_KEY=
