{
  "name": "launch-outreach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scan Product Hunt / Show HN for products in your niche, find contact emails, draft personalized outreach, send after review.",
  "scripts": {
    "scan": "node src/pipeline.js scan",
    "send": "node src/pipeline.js send",
    "auto": "node src/pipeline.js auto",
    "status": "node src/pipeline.js status",
    "followup": "node src/pipeline.js followup",
    "check-replies": "node src/pipeline.js check-replies",
    "review": "node src/pipeline.js review",
    "relay": "node src/telegram-bot.js poll",
    "relay-read": "node -e \"const fs=require('fs'),p='telegram-relay.jsonl';if(!fs.existsSync(p)){process.exit(0)}const l=fs.readFileSync(p,'utf8').trim().split('\\\\\\\\n').filter(Boolean);if(l.length){console.log(l.join('\\\\\\\\n'));fs.writeFileSync(p,'')}\"",
    "daemon": "node src/daemon.js",
    "daemon:crunchbase": "source .venv/bin/activate && PLAYWRIGHT_BROWSERS_PATH=.browsers python3 scrapers/crunchbase.py",
    "daemon:wellfound": "source .venv/bin/activate && PLAYWRIGHT_BROWSERS_PATH=.browsers python3 scrapers/wellfound_playwright.py",
    "daemon:saashub": "source .venv/bin/activate && PLAYWRIGHT_BROWSERS_PATH=.browsers python3 scrapers/saashub_playwright.py"
  },
  "dependencies": {
    "imap": "^0.8.19",
    "nodemailer": "^9.0.3",
    "playwright": "^1.61.1",
    "undici": "^8.7.0"
  }
}
