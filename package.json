{
  "name": "launch-outreach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scan Product Hunt / Show HN for products in your niche, find contact emails, draft personalized outreach, send after review.",
  "scripts": {
    "scan": "node src/pipeline.js scan",
    "send": "node src/pipeline.js send",
    "auto": "node src/pipeline.js auto",
    "status": "node src/pipeline.js status",
    "review": "node src/pipeline.js review",
    "relay": "node src/telegram-bot.js poll",
    "relay-read": "node -e \"const fs=require('fs'),p='telegram-relay.jsonl';if(!fs.existsSync(p)){process.exit(0)}const l=fs.readFileSync(p,'utf8').trim().split('\\\\n').filter(Boolean);if(l.length){console.log(l.join('\\\\n'));fs.writeFileSync(p,'')}\""
  },
  "dependencies": {
    "nodemailer": "^9.0.3"
  }
}
